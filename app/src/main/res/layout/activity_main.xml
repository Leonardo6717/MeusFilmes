<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/background" android:padding="20dp">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Meus Filmes" android:textColor="@color/text_primary"
        android:textSize="30sp" android:textStyle="bold" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Sua coleção, suas avaliações." android:textColor="@color/text_secondary"
        android:textSize="15sp" android:layout_marginTop="4dp" android:layout_marginBottom="18dp" />
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/moviesRecyclerView" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1"
        android:clipToPadding="false" android:paddingBottom="12dp" />
</LinearLayout>
