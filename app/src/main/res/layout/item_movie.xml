<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_marginBottom="12dp" app:cardBackgroundColor="@color/surface"
    app:cardCornerRadius="18dp" app:strokeColor="#393445" app:strokeWidth="1dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:padding="12dp" android:gravity="center_vertical">
        <ImageView android:id="@+id/movieImage" android:layout_width="94dp"
            android:layout_height="132dp" android:scaleType="centerCrop"
            android:contentDescription="Pôster do filme" android:background="#393445" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical" android:paddingStart="14dp">
            <TextView android:id="@+id/movieTitle" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="Título do filme"
                android:textColor="@color/text_primary" android:textSize="18sp" android:textStyle="bold" />
            <TextView android:id="@+id/movieRating" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="★ 9,0 / 10"
                android:textColor="@color/accent" android:textSize="15sp" android:layout_marginTop="8dp" />
            <com.google.android.material.button.MaterialButton android:id="@+id/editButton"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Editar" android:layout_marginTop="12dp" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
